local function refreshPlayerList()
    if not scriptsRunning then return end
    for _, child in pairs(TpContainer:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
    
    local allPlrs = Players:GetPlayers()
    local btnCount = 0
    for _, targetPlr in pairs(allPlrs) do
        if targetPlr ~= Player then
            btnCount = btnCount + 1
            local row = Instance.new("Frame", TpContainer)
            row.Size = UDim2.new(0.94, 0, 0, 32); row.BackgroundColor3 = Color3.fromRGB(45, 45, 50); Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)

            local tpBtn = Instance.new("TextButton", row)
            tpBtn.Size = UDim2.new(1, 0, 1, 0); tpBtn.BackgroundTransparency = 1
            tpBtn.Text = "  " .. targetPlr.Name; tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255); tpBtn.Font = Enum.Font.GothamSemibold; tpBtn.TextSize = 9; tpBtn.TextXAlignment = Enum.TextXAlignment.Left
            
            local actionLabel = Instance.new("TextLabel", row)
            actionLabel.Size = UDim2.new(0, 45, 1, 0); actionLabel.Position = UDim2.new(1, -50, 0, 0); actionLabel.BackgroundTransparency = 1
            actionLabel.Text = "[ TP ]"; actionLabel.TextColor3 = Color3.fromRGB(0, 255, 150); actionLabel.Font = Enum.Font.GothamBold; actionLabel.TextSize = 9

            tpBtn.MouseButton1Click:Connect(function()
                if not Character then return end
                local myRoot = Character:FindFirstChild("HumanoidRootPart")
                local targetRoot = targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart")
                if myRoot and targetRoot then myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3) end
            end)
        end
    end
    TpContainer.CanvasSize = UDim2.new(0, 0, 0, btnCount * 38 + 10)
end

