local function createSliderAndBox(name, min, max, default, callback)
    local row = Instance.new("Frame", ControlsContainer)
    row.Size = UDim2.new(0.94, 0, 0, 44); row.BackgroundColor3 = Color3.fromRGB(35, 35, 40); Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

    local title = Instance.new("TextLabel", row)
    title.Size = UDim2.new(0.5, 0, 0, 14); title.Position = UDim2.new(0.04, 0, 0, 4)
    title.Text = name:upper(); title.TextColor3 = Color3.fromRGB(200, 200, 200)
    title.Font = Enum.Font.GothamSemibold; title.TextSize = 8; title.TextXAlignment = Enum.TextXAlignment.Left

    local numBox = Instance.new("TextBox", row)
    numBox.Size = UDim2.new(0, 38, 0, 14); numBox.Position = UDim2.new(1, -46, 0, 4)
    numBox.BackgroundColor3 = Color3.fromRGB(50, 50, 55); numBox.Text = tostring(default); numBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    numBox.Font = Enum.Font.GothamBold; numBox.TextSize = 8; Instance.new("UICorner", numBox)

    local sliderBg = Instance.new("Frame", row)
    sliderBg.Size = UDim2.new(0.92, 0, 0, 3); sliderBg.Position = UDim2.new(0.04, 0, 0, 30)
    sliderBg.BackgroundColor3 = Color3.fromRGB(50, 50, 55); Instance.new("UICorner", sliderBg)

    local sliderFill = Instance.new("Frame", sliderBg)
    sliderFill.BackgroundColor3 = Color3.fromRGB(0, 255, 150); Instance.new("UICorner", sliderFill)

    local dragBtn = Instance.new("TextButton", sliderBg)
    dragBtn.Size = UDim2.new(0, 8, 0, 8); dragBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255); dragBtn.Text = ""; Instance.new("UICorner", dragBtn)

    local function syncVisuals(val)
        local clamped = math.clamp(val, min, max); local pct = (clamped - min) / (max - min)
        sliderFill.Size = UDim2.new(pct, 0, 1, 0); dragBtn.Position = UDim2.new(pct, -4, 0, -3)
        numBox.Text = tostring(clamped); callback(clamped)
    end
    
    sliderUpdates[name] = syncVisuals; syncVisuals(default)

    local active = false
    dragBtn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then active = true end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then active = false end end)
    UIS.InputChanged:Connect(function(i)
        if active and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local pct = math.clamp((i.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
            syncVisuals(math.floor(min + (pct * (max - min))))
        end
    end)
    numBox.FocusLost:Connect(function()
        local num = tonumber(numBox.Text)
        if num then syncVisuals(num) else syncVisuals(min) end
    end)
end

