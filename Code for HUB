UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not scriptsRunning then return end
    if input.KeyCode == Enum.KeyCode.K then 
        SelectorHub.Visible = not SelectorHub.Visible
    elseif input.KeyCode == binds.Fly and binds.Fly ~= Enum.KeyCode.None then toggleFly()
    elseif input.KeyCode == binds.Invis and binds.Invis ~= Enum.KeyCode.None then toggleInvis()
    elseif input.KeyCode == binds.Noclip and binds.Noclip ~= Enum.KeyCode.None then toggleNoclip()
    elseif input.KeyCode == binds.Ghost and binds.Ghost ~= Enum.KeyCode.None then toggleGhost()
    elseif input.KeyCode == binds.Freecam and binds.Freecam ~= Enum.KeyCode.None then toggleFreecam()
    elseif input.KeyCode == binds.GodMode and binds.GodMode ~= Enum.KeyCode.None then triggerGodMode()
    elseif input.KeyCode == binds.Fullbright and binds.Fullbright ~= Enum.KeyCode.None then toggleFullbright()
    elseif input.KeyCode == binds.WalkFling and binds.WalkFling ~= Enum.KeyCode.None then toggleWalkFling() end
end)

