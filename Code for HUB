-- --- SEAT WELD INVISIBILITY ---
local function setTrueInvis(state)
    if not Character or not scriptsRunning then return end
    local seatName = Player.Name .. "_InvisSeat"
    
    if state then
        if workspace:FindFirstChild(seatName) then return end 
        originalTransparencies = {}
        for _, p in ipairs(Character:GetDescendants()) do
            if (p:IsA("BasePart") or p:IsA("Decal") or p:IsA("Texture")) and p.Name ~= "HumanoidRootPart" then
                if p.Transparency < 1 then
                    originalTransparencies[p] = p.Transparency
                    p.Transparency = 0.5
                end
            end
        end
        local root = Character:FindFirstChild("HumanoidRootPart")
        local torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
        if root and torso then
            local savedCFrame = root.CFrame
            task.wait()
            Character:MoveTo(Vector3.new(-9999, 9999, -9999)) 
            task.wait(0.15)
            local seat = Instance.new("Seat", workspace)
            seat.Name = seatName; seat.Anchored = false; seat.CanCollide = false; seat.Transparency = 1; seat.Position = Vector3.new(-9999, 9999, -9999)
            local weld = Instance.new("Weld", seat)
            weld.Part0 = seat; weld.Part1 = torso
            seat.CFrame = savedCFrame
        end
    else
        local seat = workspace:FindFirstChild(seatName)
        if seat then seat:Destroy() end
        for p, trans in pairs(originalTransparencies) do
            if p and p.Parent then p.Transparency = trans end
        end
        originalTransparencies = {}
    end
end

-- --- FREECAM ENGINE ---
local fcPos, fcRotX, fcRotY
local fcProxyPart = Instance.new("Part")
fcProxyPart.Transparency = 1; fcProxyPart.CanCollide = false; fcProxyPart.Anchored = true; fcProxyPart.Size = Vector3.new(1,1,1)

local function toggleFreecam(state)
    freecamActive = (state ~= nil) and state or not freecamActive
    if freecamActive then
        Camera.CameraType = Enum.CameraType.Scriptable
        fcProxyPart.CFrame = Camera.CFrame
        fcProxyPart.Parent = workspace
        pcall(function() Player.ReplicationFocus = fcProxyPart end)
        
        fcPos = Camera.CFrame.Position
        local rx, ry, rz = Camera.CFrame:ToEulerAnglesYXZ()
        fcRotX, fcRotY = rx, ry
        
        fcConnection = RunService.RenderStepped:Connect(function(deltaTime)
            if not scriptsRunning then return end
            
            local delta = UIS:GetMouseDelta()
            if delta.Magnitude > 0 then
                if UIS.TouchEnabled then
                    fcRotY = fcRotY - math.rad(delta.X * 0.25)
                    fcRotX = math.clamp(fcRotX - math.rad(delta.Y * 0.25), -math.rad(89), math.rad(89))
                elseif UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                    UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
                    fcRotY = fcRotY - math.rad(delta.X * 0.3)
                    fcRotX = math.clamp(fcRotX - math.rad(delta.Y * 0.3), -math.rad(89), math.rad(89))
                end
            else
                if not UIS.TouchEnabled then UIS.MouseBehavior = Enum.MouseBehavior.Default end
            end
            
            local finalDirection = getMoveDirection()
            fcPos = fcPos + (finalDirection * (freecamSpeed * deltaTime))
            
            local finalCFrame = CFrame.new(fcPos) * CFrame.fromEulerAnglesYXZ(fcRotX, fcRotY, 0)
            Camera.CFrame = finalCFrame
            fcProxyPart.CFrame = finalCFrame
        end)
    else
        UIS.MouseBehavior = Enum.MouseBehavior.Default
        pcall(function() Player.ReplicationFocus = nil end)
        fcProxyPart.Parent = nil
        if fcConnection then fcConnection:Disconnect() fcConnection = nil end
        Camera.CameraType = Enum.CameraType.Custom
        if Character then Camera.CameraSubject = Character:FindFirstChildOfClass("Humanoid") end
    end
    setCharacterMovement(not freecamActive)
    if updateVisuals then updateVisuals() end
end

-- --- FLIGHT MODULE ---
local function startFlying()
    if not scriptsRunning then return end
    local root = Character:FindFirstChild("HumanoidRootPart")
    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end
    humanoid.PlatformStand = true
    
    bv = Instance.new("BodyVelocity", root); bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bg = Instance.new("BodyGyro", root); bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    
    renderConnection = RunService.RenderStepped:Connect(function()
        if not scriptsRunning then return end
        if freecamActive then bv.Velocity = Vector3.new(0,0,0) return end
        
        bg.CFrame = Camera.CFrame
        local finalDirection = getMoveDirection()
        bv.Velocity = finalDirection * flySpeed
    end)
end

local function stopFlying()
    if renderConnection then renderConnection:Disconnect() renderConnection = nil end
    if bv then bv:Destroy() end
    if bg then bg:Destroy() end
    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.PlatformStand = false end
end

