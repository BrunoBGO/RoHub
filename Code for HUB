    bindBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 55); bindBtn.Text = binds[name] and binds[name].Name or "NONE"
    bindBtn.TextColor3 = Color3.fromRGB(0, 255, 150); bindBtn.Font = Enum.Font.GothamBold; bindBtn.TextSize = 9; Instance.new("UICorner", bindBtn)

    local listening = false
